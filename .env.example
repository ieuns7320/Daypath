# 이 파일을 복사해 .env.local 로 만들고 값을 채우세요. (.env.local 은 git에 올라가지 않아요)
# 값은 Supabase 대시보드 > Project Settings > API 에서 확인할 수 있어요.
# 비워 두면 앱은 "로컬 모드"(이 브라우저에만 저장)로 동작해요.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 알림(Web Push) 공개 키. node scripts/make-push-keys.mjs 로 만든다.
# 비공개 키(VAPID_PRIVATE_KEY)와 PUSH_SECRET 은 Vercel 에만 넣는다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
