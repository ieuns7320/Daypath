{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "daypath-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "daypath-local-mode",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "require('child_process').spawn('npx',['next','dev','-p','3001'],{stdio:'inherit',shell:true,env:{...process.env,NEXT_PUBLIC_SUPABASE_URL:'',NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:''}})"
      ],
      "port": 3001
    }
  ]
}
